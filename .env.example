# Copy to .env.local for local dev. On Vercel set these in
# Project → Settings → Environment Variables.

# --- Content source ------------------------------------------------------
# Normally leave this unset: the site uses Supabase when DATABASE_URL is set
# and data/content.json when it is not, so there is no second flag to forget.
# Set it only to override that:
#   db        — Supabase via Drizzle
#   json      — data/content.json, the file the owner console edits
#   fixtures  — the hard-coded seed in src/lib/data/fixtures.ts
#   api       — through this app's own route handlers
# DATA_SOURCE=

# NOTE: there is deliberately no CONTENT_FILE override here. The path is a
# literal in src/lib/data/content-file.ts so the bundler can resolve it — an
# env-var path makes it trace the whole project and ship all of public/ inside
# every serverless function. The owner console has its own override.

# --- Showcase deployment -------------------------------------------------
# Set to 1 on the Vercel POC. That filesystem is read-only, so a booking
# request cannot be stored — this puts a visible note on the booking form
# saying so, instead of quietly losing somebody's holiday enquiry.
# NEXT_PUBLIC_DEMO=1

# Forces the read-only write path without Vercel's own env var — useful for
# reproducing the deployed behaviour locally.
# CONTENT_READONLY=1

# --- Misc ----------------------------------------------------------------
# Used by the `api` data source and for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the owner console sends to POST /api/revalidate.
# Required: the endpoint refuses every call when this is unset, rather than
# falling back to a default that is in the repo and therefore not a secret.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Bearer token for /api/admin/* — the content import, the health check and
# the booking inbox. Same generator as above, different value. Unset means
# those endpoints are disabled, which is the safe way for a deploy to fail.
ADMIN_API_SECRET=

# --- Supabase ------------------------------------------------------------
# Supabase → Project Settings → API Keys. Only needed for Supabase Auth and
# Storage; the catalogue goes over DATABASE_URL, not these.
#
# Supabase renamed these: the "publishable" key is the old anon key and is
# safe in the browser, the "secret" key is the old service_role key and
# bypasses row level security entirely — server-only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Supabase → Project Settings → Database → Connection string → "Transaction".
# Port 6543 (the pooler) is required on Vercel; 5432 runs out of connections.
# Setting this is what switches the site from the JSON file to Postgres.
DATABASE_URL=

# Max connections per serverless instance. The pooler's ceiling is shared
# across every running function, so this stays small on purpose.
# DATABASE_POOL_MAX=5

# --- Owner notifications for booking requests ---------------------------
# RESEND_API_KEY=
# OWNER_NOTIFY_EMAIL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
